<Window x:Class="LineTray.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LINEを最小化して起動" Width="680" Height="720" MinWidth="520" MinHeight="480"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" Icon="app.ico"
        Background="{DynamicResource WindowBrush}" FontFamily="Segoe UI Variable Text, Segoe UI, Yu Gothic UI" FontSize="13"
        TextOptions.TextFormattingMode="Ideal">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Styles.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <StackPanel Margin="28,24,28,20">
        <Grid Margin="0,0,0,6">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Image Source="app.ico" Width="40" Height="40" Margin="0,0,14,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="LINEを最小化して起動" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
            <TextBlock Text="サインイン時に、LINEを画面に出さずに通知領域で起動します。" Foreground="{DynamicResource SecondaryBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
          </StackPanel>
        </Grid>

        <!-- Information bars, shown only when they apply. -->
        <Border x:Name="LineWarning" Background="{DynamicResource WarnBackBrush}" CornerRadius="6" Padding="14,12" Margin="0,16,0,0" Visibility="Collapsed">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Grid Width="16" Height="16" VerticalAlignment="Top" Margin="0,1,12,0">
              <Ellipse Fill="{DynamicResource WarnIconBrush}"/>
              <TextBlock Text="!" Foreground="{DynamicResource WarnBackBrush}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <StackPanel Grid.Column="1">
              <TextBlock Text="LINE本体の自動起動がオンになっています" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
              <TextBlock Text="このままだと、サインイン時にLINEが通常の画面でも開きます。Windowsのスタートアップ設定で「LINE」をオフにしてください。" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" Margin="0,2,0,0" LineHeight="19"/>
            </StackPanel>
            <Button x:Name="LineWarningButton" Grid.Column="2" Content="設定を開く" VerticalAlignment="Center" Margin="12,0,0,0"/>
          </Grid>
        </Border>

        <TextBlock Text="自動起動" Style="{StaticResource SectionTitle}"/>
        <Border Style="{StaticResource Card}">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
              <TextBlock Text="サインイン時に通知領域で起動" Style="{StaticResource CardTitle}"/>
              <TextBlock x:Name="AutoStartText" Style="{StaticResource CardText}"/>
              <Button x:Name="AutoStartSettingsButton" Content="スタートアップ設定を開く" Style="{StaticResource LinkButton}" Margin="0,6,0,0" HorizontalAlignment="Left" Visibility="Collapsed"/>
            </StackPanel>
            <CheckBox x:Name="AutoStartToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                      AutomationProperties.Name="サインイン時に通知領域で起動"/>
          </Grid>
        </Border>
        <Border Style="{StaticResource Card}">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
              <TextBlock Text="LINE本体の自動起動" Style="{StaticResource CardTitle}"/>
              <TextBlock Text="二重に起動しないよう、Windowsのスタートアップ設定でオフにしておきます。" Style="{StaticResource CardText}"/>
            </StackPanel>
            <TextBlock x:Name="LineStateText" Grid.Column="1" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryBrush}"/>
          </Grid>
        </Border>

        <TextBlock Text="動作の確認" Style="{StaticResource SectionTitle}"/>
        <Border Style="{StaticResource Card}">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
              <TextBlock Text="今すぐ通知領域で起動" Style="{StaticResource CardTitle}"/>
              <TextBlock x:Name="LaunchText" Style="{StaticResource CardText}"
                         Text="LINEを画面に出さずに起動します。LINEが起動中のときは、通知領域のアイコンを右クリックして「終了」してから押してください。"/>
            </StackPanel>
            <Button x:Name="LaunchButton" Grid.Column="1" Content="LINEを起動" VerticalAlignment="Center"/>
          </Grid>
        </Border>
        <Border Background="{DynamicResource InfoBackBrush}" CornerRadius="6" Padding="14,12" Margin="0,4,0,0">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Grid Width="16" Height="16" VerticalAlignment="Top" Margin="0,1,12,0">
              <Ellipse Fill="{DynamicResource AccentBrush}"/>
              <TextBlock Text="i" Foreground="{DynamicResource AccentTextBrush}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <TextBlock Grid.Column="1" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" LineHeight="19"
                       Text="LINEはメールアドレスとパスワードなどでログインし、自動ログインをオンにしておいてください。QRコードでログインすると、終了や再起動のたびにログアウトされます。ログアウトした状態で起動したときは、ログイン画面が表示されます。"/>
          </Grid>
        </Border>

        <TextBlock Text="更新" Style="{StaticResource SectionTitle}"/>
        <Border Style="{StaticResource Card}">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
              <TextBlock x:Name="UpdateTitle" Text="バージョン" Style="{StaticResource CardTitle}"/>
              <TextBlock x:Name="UpdateText" Style="{StaticResource CardText}"/>
              <ProgressBar x:Name="Progress" Height="3" Margin="0,8,0,0" Maximum="100" Visibility="Collapsed"
                           Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource DividerBrush}" BorderThickness="0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <Button x:Name="CheckButton" Content="更新を確認"/>
              <Button x:Name="UpdateButton" Content="更新して再起動" Style="{StaticResource AccentButton}" Margin="8,0,0,0" Visibility="Collapsed"/>
            </StackPanel>
          </Grid>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="1" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="28,12,28,14">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal">
          <Button x:Name="HelpButton" Content="使い方" Style="{StaticResource LinkButton}" Margin="0,0,20,0"/>
          <Button x:Name="FolderButton" Content="記録の場所" Style="{StaticResource LinkButton}" Margin="0,0,20,0"/>
          <Button x:Name="GithubButton" Content="GitHub" Style="{StaticResource LinkButton}" Margin="0,0,20,0"/>
          <Button x:Name="UninstallButton" Content="アンインストール" Style="{StaticResource LinkButton}"/>
        </StackPanel>
        <TextBlock x:Name="VersionText" Grid.Column="2" Foreground="{DynamicResource SecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
      </Grid>
    </Border>
  </Grid>
</Window>
